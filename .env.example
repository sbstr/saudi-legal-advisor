PORT=4174
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# Required: get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_TRANSLATE_MODEL=claude-haiku-4-5-20251001

# Required: any long random string, used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional: enables the "Sign in with Google" button. Create an OAuth Client ID
# (type: Web application) at https://console.cloud.google.com/apis/credentials,
# add your site's origin (e.g. http://localhost:4174) under "Authorized JavaScript
# origins", and paste the Client ID here. Leave empty to hide the Google button and
# only offer email/password sign-in.
GOOGLE_CLIENT_ID=

# How many free consultations a new account gets before the chat requires an active
# paid plan.
FREE_TRIAL_CONSULTATIONS=1

# Set to "true" once the site is served over HTTPS in production, so session cookies
# get the Secure flag. Keep false for local http:// development.
COOKIE_SECURE=false
